# ============================================================
# CutFlow Backend — Environment Variables
#
# DEPLOYMENT:
#   Railway: set these as service Variables. Reference the Postgres/Redis
#            plugins instead of pasting values:
#              DATABASE_URL = ${{Postgres.DATABASE_URL}}
#              REDIS_URL    = ${{Redis.REDIS_URL}}
#   Local:   copy to .env and fill in values.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Render PostgreSQL sets this automatically via render.yaml.
# For local Docker Compose: postgresql://postgres:password@localhost:5432/cutflow
DATABASE_URL="postgresql://postgres:password@localhost:5432/cutflow?schema=public"

# ── Redis ─────────────────────────────────────────────────────
# Render Redis sets this automatically via render.yaml.
# For local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ── JWT (required — generate strong random secrets) ──────────
JWT_SECRET="replace-with-64-char-random-string"
JWT_REFRESH_SECRET="replace-with-another-64-char-random-string"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── CORS ──────────────────────────────────────────────────────
# Set to your Vercel production URL.
# Vercel preview deployments (*.vercel.app) are always allowed.
# Comma-separate multiple exact origins if needed.
FRONTEND_URL="https://your-app.vercel.app"

# ── Google OAuth (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match exactly what is registered in Google Cloud Console:
# https://cutflow-server-production.up.railway.app/v1/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# ── Stripe (optional) ─────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Cloudflare R2 (preferred — takes precedence over S3 when set) ────────────
# If R2_ACCOUNT_ID is set, R2 is used. Leave blank to use AWS S3 instead.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cutflow-media"
# Public URL for your R2 bucket (custom domain or r2.dev URL):
R2_PUBLIC_URL=""

# ── AWS S3 (fallback when R2 is not configured) ───────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="cutflow-media"

# ── OpenAI (optional) ─────────────────────────────────────────
OPENAI_API_KEY=""

# ── Resend (email delivery) ───────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@cutflow.app"

# ── ElevenLabs (optional) ─────────────────────────────────────
ELEVENLABS_API_KEY=""

# ── Replicate (optional) ──────────────────────────────────────
REPLICATE_API_TOKEN=""

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
