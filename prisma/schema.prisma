generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  TRIAL
  ACTIVE
  CANCELED
  PAST_DUE
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum VideoStatus {
  DRAFT
  PROCESSING
  READY
  EXPORTED
  ERROR
}

enum MediaType {
  MAIN
  BROLL
  STOCK
  AI_GENERATED
}

enum ExportResolution {
  P720
  P1080
  P4K
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TWITTER
}

enum MusicStyle {
  CALM
  ENERGETIC
  CORPORATE
  EMOTIONAL
  UPBEAT
  EPIC
}

enum TemplateTier {
  FREE
  PAID
  PREMIUM
}

enum AssetType {
  TEMPLATE
  STICKER
  TEXT_STYLE
  OVERLAY
  TRANSITION
  CTA
  FONT
  COLOR_PALETTE
}

enum NotificationType {
  EMAIL
  IN_APP
  BOTH
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  passwordHash          String?
  googleId              String?         @unique
  firstName             String?
  lastName              String?
  avatarUrl             String?
  role                  UserRole        @default(USER)
  isActive              Boolean         @default(true)
  emailVerified         Boolean         @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  subscription          Subscription?
  videoProjects         VideoProject[]
  refreshTokens         RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  analyticsEvents       AnalyticsEvent[]
  notifications         Notification[]
  userTemplates         UserTemplate[]
  brandKit              BrandKit?
  webhooks              Webhook[]
  referralsGiven        Referral[]      @relation("Referrer")
  referralsReceived     Referral?       @relation("Referred")
  socialConnections     SocialConnection[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  token       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Plan {
  id                    String      @id @default(uuid())
  name                  String
  tier                  PlanTier    @default(FREE)
  stripePriceId         String?     @unique
  priceMonthly          Decimal     @db.Decimal(10, 2)
  priceYearly           Decimal     @db.Decimal(10, 2)
  videoLimit            Int         @default(0)
  maxVideoDuration      Int         @default(60)
  maxStorageGb          Int         @default(1)
  includesAiEditing     Boolean     @default(false)
  includesAiCaptions    Boolean     @default(false)
  includesAiVoice       Boolean     @default(false)
  includesAiAvatar      Boolean     @default(false)
  includesAiMusic       Boolean     @default(false)
  includes4K            Boolean     @default(false)
  includesBrandKit      Boolean     @default(false)
  includesTeamWorkspaces Boolean   @default(false)
  features              Json        @default("[]")
  isActive              Boolean     @default(true)
  sortOrder             Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  subscriptions         Subscription[]

  @@map("plans")
}

model Subscription {
  id                    String              @id @default(uuid())
  userId                String              @unique
  planId                String
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  status                SubscriptionStatus  @default(INACTIVE)
  videoCount            Int                 @default(0)
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  Plan                @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model VideoProject {
  id                    String          @id @default(uuid())
  userId                String
  title                 String
  description           String?
  status                VideoStatus     @default(DRAFT)
  aspectRatio           String          @default("16:9")
  duration              Int?
  thumbnailUrl          String?
  metadata              Json            @default("{}")
  aiEditsApplied        Json            @default("[]")
  isDeleted             Boolean         @default(false)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFiles            MediaFile[]
  exports               VideoExport[]
  caption               Caption?
  aiScript              AIScript?
  splitTestSessions     SplitTestSession[]
  templateApplication   TemplateApplication?
  processingJobs        ProcessingJob[]
  versionHistory        ProjectVersion[]
  
  // Foreign keys for optional relations
  musicTrackId          String?
  voiceTrackId          String?
  musicTrack            MusicTrack?     @relation(fields: [musicTrackId], references: [id])
  voiceTrack            VoiceTrack?     @relation(fields: [voiceTrackId], references: [id])

  @@map("video_projects")
}

model MediaFile {
  id                    String      @id @default(uuid())
  projectId             String
  type                  MediaType   @default(MAIN)
  originalName          String
  s3Key                 String      @unique
  s3Url                 String
  mimeType              String
  size                  Int
  duration              Int?
  width                 Int?
  height                Int?
  isPrimary             Boolean     @default(false)
  timelinePosition      Int?
  metadata              Json        @default("{}")
  createdAt             DateTime    @default(now())

  project               VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("media_files")
}

model VideoExport {
  id                    String            @id @default(uuid())
  projectId             String
  resolution            ExportResolution  @default(P1080)
  platform              Platform?
  s3Key                 String?
  s3Url                 String?
  fileSize              Int?
  duration              Int?
  status                JobStatus         @default(PENDING)
  progress              Int                 @default(0)
  errorMessage          String?
  renderStartedAt       DateTime?
  renderCompletedAt     DateTime?
  expiresAt             DateTime?
  downloadCount         Int                 @default(0)
  lastDownloadedAt      DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  project               VideoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("video_exports")
}

model Caption {
  id                    String      @id @default(uuid())
  projectId             String      @unique
  language              String      @default("en")
  segments              Json        // Array of { start, end, text, words[] }
  style                 Json        @default("{}")  // { font, color, size, position, animated }
  keywords              String[]    @default([])
  isAnimated            Boolean     @default(false)
  wordHighlighting      Boolean     @default(false)
  confidence            Float?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  project               VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("captions")
}

model AIScript {
  id                    String      @id @default(uuid())
  projectId             String      @unique
  title                 String?
  sourceType            String      // url, text, product_page
  sourceContent         String?
  sourceUrl             String?
  tone                  String      // sales, educational, emotional, storytelling
  language              String      @default("en")
  generatedScript       String
  suggestedBrolls       String[]    @default([])
  hookVariants          Json        @default("[]")  // Array of hook variations
  selectedHookIndex     Int         @default(0)
  wordCount             Int?
  estimatedDuration     Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  project               VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_scripts")
}

model SplitTestSession {
  id                    String      @id @default(uuid())
  projectId             String
  name                  String
  variants              Json        // Array of variant configs
  status                JobStatus   @default(PENDING)
  totalVariants         Int
  exportedCount         Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  project               VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("split_test_sessions")
}

model MusicTrack {
  id                    String          @id @default(uuid())
  style                 MusicStyle
  s3Key                 String          @unique
  s3Url                 String
  duration              Int
  isAiGenerated         Boolean         @default(true)
  beatTimestamps        Json?           // Array of beat times for sync
  moodTags              String[]        @default([])
  createdAt             DateTime        @default(now())

  videoProjects         VideoProject[]

  @@map("music_tracks")
}

model VoiceTrack {
  id                    String          @id @default(uuid())
  voiceId               String          // ElevenLabs voice ID
  voiceName             String
  s3Key                 String          @unique
  s3Url                 String
  transcript            String
  duration              Int
  accent                String?
  gender                String?
  age                   String?
  createdAt             DateTime        @default(now())

  videoProjects         VideoProject[]

  @@map("voice_tracks")
}

model Template {
  id                    String          @id @default(uuid())
  name                  String
  category              String          // ads, reels, social, business, etc.
  tier                  TemplateTier    @default(FREE)
  description           String?
  previewUrl            String?
  thumbnailUrl          String?
  config                Json            // Template configuration JSON
  aspectRatios          String[]        @default(["16:9", "9:16", "1:1"])
  estimatedDuration     Int?
  tags                  String[]        @default([])
  industry              String?
  style                 String?         // minimal, bold, corporate, etc.
  isActive              Boolean         @default(true)
  sortOrder             Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  applications          TemplateApplication[]
  userSaves             UserTemplate[]

  @@map("templates")
}

model TemplateApplication {
  id                    String          @id @default(uuid())
  projectId             String          @unique
  templateId            String
  appliedConfig         Json            // Applied template config with user edits
  createdAt             DateTime        @default(now())

  project               VideoProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template              Template        @relation(fields: [templateId], references: [id])

  @@map("template_applications")
}

model CreativeAsset {
  id                    String          @id @default(uuid())
  name                  String
  type                  AssetType
  category              String
  tier                  TemplateTier    @default(FREE)
  s3Key                 String          @unique
  s3Url                 String
  thumbnailUrl          String?
  tags                  String[]        @default([])
  metadata              Json            @default("{}")  // Font family, colors, animations, etc.
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("creative_assets")
}

model BrollCategory {
  id                    String          @id @default(uuid())
  name                  String
  sortOrder             Int             @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  subcategories         BrollSubcategory[]

  @@map("broll_categories")
}

model BrollSubcategory {
  id                    String          @id @default(uuid())
  categoryId            String
  name                  String
  sortOrder             Int             @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  category              BrollCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items                 BrollItem[]

  @@map("broll_subcategories")
}

model BrollItem {
  id                    String          @id @default(uuid())
  subcategoryId         String
  name                  String
  description           String?
  s3Key                 String          @unique
  s3Url                 String
  thumbnailUrl          String?
  type                  String          @default("video")  // video, image
  isPremium             Boolean         @default(false)
  duration              Int?            // in seconds for videos
  tags                  String[]        @default([])
  sortOrder             Int             @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  subcategory           BrollSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@map("broll_items")
}

model UserTemplate {
  id                    String          @id @default(uuid())
  userId                String
  templateId            String
  customName            String?
  customConfig          Json            @default("{}")
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template              Template        @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@map("user_templates")
}

model AdminUser {
  id                    String          @id @default(uuid())
  userId                String          @unique
  permissions           String[]        @default([])
  canManageUsers        Boolean         @default(false)
  canManageSubscriptions Boolean        @default(false)
  canManageTemplates    Boolean         @default(false)
  canManageAssets       Boolean         @default(false)
  canViewAnalytics      Boolean         @default(false)
  canManageFeatureFlags Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("admin_users")
}

model AnalyticsEvent {
  id                    String          @id @default(uuid())
  userId                String?
  event                 String
  category              String?         // video, ai, export, subscription, etc.
  metadata              Json            @default("{}")
  sessionId             String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime        @default(now())

  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("analytics_events")
}

model Notification {
  id                    String          @id @default(uuid())
  userId                String
  type                  NotificationType @default(IN_APP)
  title                 String
  message               String
  isRead                Boolean         @default(false)
  actionUrl             String?
  metadata              Json            @default("{}")
  sentAt                DateTime?
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id                    String          @id @default(uuid())
  userId                String          @unique
  emailOnExportComplete Boolean         @default(true)
  emailOnSubscriptionChange Boolean     @default(true)
  emailOnNewFeatures    Boolean         @default(true)
  emailMarketing        Boolean         @default(false)
  inAppOnExportComplete Boolean         @default(true)
  inAppOnAiJobComplete  Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("notification_preferences")
}

model ProcessingJob {
  id                    String          @id @default(uuid())
  projectId             String
  jobType               String          // silence_removal, caption_generation, export, etc.
  status                JobStatus       @default(PENDING)
  progress              Int             @default(0)
  inputData             Json            @default("{}")
  outputData            Json            @default("{}")
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?
  bullJobId             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  project               VideoProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("processing_jobs")
}

model ProjectVersion {
  id                    String          @id @default(uuid())
  projectId             String
  versionNumber         Int
  snapshot              Json            // Full project state snapshot
  changeDescription     String?
  createdAt             DateTime        @default(now())

  project               VideoProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@map("project_versions")
}

model BrandKit {
  id                    String          @id @default(uuid())
  userId                String          @unique
  logoUrl               String?
  primaryColor          String?
  secondaryColor        String?
  accentColor           String?
  fontFamily            String?
  fontFamilySecondary   String?
  defaultCaptionStyle   Json            @default("{}")
  watermarkEnabled      Boolean         @default(false)
  watermarkUrl          String?
  watermarkPosition     String          @default("bottom-right")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model Webhook {
  id                    String          @id @default(uuid())
  userId                String
  url                   String
  secret                String          @default(uuid())
  events                String[]        @default([])  // export.complete, video.created, etc.
  isActive              Boolean         @default(true)
  lastTriggeredAt       DateTime?
  lastStatusCode          Int?
  failureCount          Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries            WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id                    String          @id @default(uuid())
  webhookId             String
  event                 String
  payload               Json
  responseStatusCode    Int?
  responseBody          String?
  errorMessage          String?
  deliveredAt           DateTime?
  createdAt             DateTime        @default(now())

  webhook               Webhook         @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

model Referral {
  id                    String          @id @default(uuid())
  referrerId            String          @unique
  referredId            String          @unique
  referralCode          String          @unique
  bonusCreditsGranted   Boolean         @default(false)
  createdAt             DateTime        @default(now())

  referrer              User            @relation("Referrer", fields: [referrerId], references: [id])
  referred              User            @relation("Referred", fields: [referredId], references: [id])

  @@map("referrals")
}

model SocialConnection {
  id                    String          @id @default(uuid())
  userId                String
  platform              Platform
  accessToken           String
  refreshToken          String?
  tokenExpiresAt        DateTime?
  platformUserId        String
  platformUserName      String?
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("social_connections")
}

model FeatureFlag {
  id                    String          @id @default(uuid())
  key                   String          @unique
  name                  String
  description           String?
  enabled               Boolean         @default(false)
  targetPercent         Int?            // Percentage rollout
  allowedUserIds        String[]        @default([])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("feature_flags")
}
